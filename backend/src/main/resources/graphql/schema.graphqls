type Query {
    goals: [Goal!]!
    goalById(id: ID!): Goal

    # A cheap change-signature for the current user's whole goal graph, used by
    # background sync to avoid re-fetching the full `goals` payload when nothing
    # changed. Format: "<maxUpdatedAtMicros>:<totalRowCount>" across goals and
    # their nested reality/options/targets/checklist/resources. It changes on any
    # insert, update (max advances) or delete (count changes), so a client can
    # poll this and only run `goals` when the value differs from what it last saw.
    goalsRevision: String!

    resourcesByGoal(goalId: ID!): [Resource!]!
    resourceById(id: ID!): Resource

    targetsByGoal(goalId: ID!): [Target!]!
    targetById(id: ID!): Target

    optionsByGoal(goalId: ID!): [Option!]!
    realityByGoal(goalId: ID!): Reality!
    realityItemById(id: ID!): RealityItem

    # The All-goals page's Upcoming column. A link (kind goal | target | task) carries only the id
    # of what it points at; its date is that item's deadline, read from the goal graph.
    upcomingEvents: [UpcomingEvent!]!
    # Events with a reminder that has gone off and is not answered yet — the "decide now" page.
    dueReminders: [DueReminder!]!
}

type Mutation {
    createGoal(input: CreateGoalInput!): Goal!
    updateGoal(id: ID!, input: UpdateGoalInput!): Goal!
    deleteGoal(id: ID!): Boolean!

    addRealityItem(goalId: ID!, kind: String!, text: String!): Reality!
    updateRealityItem(goalId: ID!, kind: String!, itemId: ID!, text: String!): Reality!
    removeRealityItem(goalId: ID!, kind: String!, itemId: ID!): Reality!

    addOption(goalId: ID!, text: String!): Option!
    updateOption(goalId: ID!, optionId: ID!, input: UpdateOptionInput!): Option!
    selectOption(goalId: ID!, optionId: ID!): Option!
    removeOption(goalId: ID!, optionId: ID!): Boolean!
    reorderOptions(goalId: ID!, optionIds: [ID!]!): [Option!]!

    createTarget(goalId: ID!, input: CreateTargetInput!): Target!
    updateTarget(id: ID!, input: UpdateTargetInput!): Target!
    deleteTarget(id: ID!): Boolean!

    createResource(goalId: ID!, input: CreateResourceInput!): Resource!
    updateResource(id: ID!, input: UpdateResourceInput!): Resource!
    deleteResource(id: ID!): Boolean!

    createUpcomingEvent(input: CreateUpcomingEventInput!): UpcomingEvent!
    # Deleting a link also clears the deadline of the goal, target or task it points at.
    deleteUpcomingEvent(id: ID!): Boolean!
    # Replaces the event's time and reminders as sent; title and date apply to an important date only.
    updateUpcomingEvent(id: ID!, input: UpdateUpcomingEventInput!): UpcomingEvent!
    # done | open | snooze — answers every due reminder of the event. False when none was due.
    answerReminder(eventId: ID!, action: String!): Boolean!
    # The IANA zone the client runs in ("Europe/Berlin"); reminders are computed in it.
    setTimeZone(zone: String!): Boolean!
}

type UpcomingEvent {
    id: ID!
    # important | goal | target | task
    kind: String!
    # Only for kind = important.
    title: String
    date: String
    goalId: ID
    targetId: ID
    taskId: ID
    # HH:mm, or null for an all-day date. The entry's own, for any kind.
    time: String
    reminders: [UpcomingReminder!]!
}

type UpcomingReminder {
    id: ID!
    # 0 = on the day (all day) / at the time (timed)
    amount: Int!
    # minute | hour | day | week
    unit: String!
    # All-day events only: minutes after midnight.
    atMinuteOfDay: Int
    # notification | email | fullscreen
    channel: String!
}

type DueReminder {
    eventId: ID!
    kind: String!
    title: String!
    date: String
    time: String
    # The goal to open: the event's own goal, or the goal its target or task belongs to.
    goalId: ID
    firedAt: String!
}

input ReminderInput {
    amount: Int!
    unit: String!
    atMinuteOfDay: Int
    channel: String
}

input CreateUpcomingEventInput {
    kind: String!
    title: String
    date: String
    goalId: ID
    targetId: ID
    taskId: ID
    time: String
    reminders: [ReminderInput!]
}

input UpdateUpcomingEventInput {
    title: String
    date: String
    time: String
    reminders: [ReminderInput!]
}

type Goal {
    id: ID!
    title: String!
    description: String!
    confidence: Int!
    deadline: String
    createdAt: String!
    achievedAt: String
    reality: Reality!
    options: [Option!]!
    resources: [Resource!]!
    targets: [Target!]!
    progress: Float!
    updatedAt: String!
    confidenceHistory: [ConfidenceHistory!]!
}

type ConfidenceHistory {
    id: ID!
    confidence: Int!
    at: String!
}

type Reality {
    id: ID!
    actions: [RealityItem!]!
    obstacles: [RealityItem!]!
}

type RealityItem {
    id: ID!
    text: String!
    createdAt: String!
    updatedAt: String!
}

type Option {
    id: ID!
    text: String!
    # The "active" radio — single-select across the goal, independent of `status`.
    selected: Boolean!
    # The thumb lean: "none" | "good_idea" | "didnt_work" — mutually exclusive among
    # themselves, but independent of `selected` (an option can be active AND thumbed).
    status: String!
    position: Int!
    createdAt: String!
    updatedAt: String!
}

type Target {
    id: ID!
    type: String!
    title: String!
    start: Float
    current: Float
    total: Float
    unit: String
    done: Boolean
    items: [ChecklistItem!]!
    deadline: String
    achievedAt: String
    progress: Float!
    progressLocked: Boolean
    createdAt: String!
    updatedAt: String!
}

type ChecklistItem {
    id: ID!
    text: String!
    done: Boolean!
    deadline: String
    achievedAt: String
    createdAt: String!
    updatedAt: String!
}

type Resource {
    id: ID!
    type: String!
    title: String
    body: String
    url: String
    mime: String
    dataUrl: String
    name: String
    role: String
    email: String
    phone: String
    driveWebViewLink: String
    createdAt: String!
    updatedAt: String!
}

input CreateGoalInput {
    title: String!
    description: String
    confidence: Int!
    deadline: String
}

input UpdateGoalInput {
    title: String
    description: String
    confidence: Int
    deadline: String
    achievedAt: String
}

input UpdateOptionInput {
    text: String
    # The "active" radio, independent of `status`.
    selected: Boolean
    # The thumb lean: "none" | "good_idea" | "didnt_work".
    status: String
}

input CreateTargetInput {
    title: String!
    type: String!
    deadline: String
    start: Float
    current: Float
    total: Float
    unit: String
    done: Boolean
    items: [ChecklistItemInput!]
}

input UpdateTargetInput {
    title: String
    deadline: String
    achievedAt: String
    start: Float
    current: Float
    total: Float
    unit: String
    done: Boolean
    progressLocked: Boolean
    items: [ChecklistItemInput!]
}

input ChecklistItemInput {
    id: ID
    text: String!
    done: Boolean
    deadline: String
    achievedAt: String
}

input CreateResourceInput {
    type: String!
    title: String
    body: String
    url: String
    mime: String
    dataUrl: String
    name: String
    role: String
    email: String
    phone: String
}

input UpdateResourceInput {
    title: String
    body: String
    url: String
    mime: String
    dataUrl: String
    name: String
    role: String
    email: String
    phone: String
}

