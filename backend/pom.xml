<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 3.5.15: patches the CRITICAL CVEs the dependency scan caught in
             3.4.5 — Tomcat ≥10.1.55 (HTTP/2 header validation, digest-auth
             bypass, improper authorization) and Spring Security ≥6.5.9
             (method-security bypass, policy-bypass/info-disclosure). -->
        <version>3.5.15</version>
        <relativePath/>
    </parent>

    <groupId>com.spiramindscape</groupId>
    <artifactId>spira-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>spira-backend</name>
    <description>Backend persistence API for Spira Mindscape</description>

    <properties>
        <java.version>17</java.version>
        <flyway.version>10.13.0</flyway.version>
        <lombok.version>1.18.32</lombok.version>
        <!-- Ahead of the parent, on purpose. Boot 3.5.15 (and 3.5.16, the newest 3.5.x at the
             time of writing) still pins Tomcat 10.1.55, which carries three CRITICAL CVEs —
             CVE-2026-65182 (security-constraint bypass), CVE-2026-65905 (authentication bypass)
             and CVE-2026-68525 (unauthorized access), all fixed in 10.1.58. That is what turned
             the nightly CI red from 2026-09-03: the scan blocks on CRITICAL only, and no code
             change was involved — the CVEs were simply published. 10.1.59 is the newest 10.1.x.
             Drop this override once the parent itself ships ≥10.1.58. -->
        <tomcat.version>10.1.59</tomcat.version>
        <!-- Also ahead of the parent, for the HIGH findings the same scan reports. These are
             properties Boot itself declares, so overriding them here moves the whole managed
             set rather than one artifact:
               netty 4.1.135 → 4.1.136  (CVE in netty-codec-http)
               postgresql 42.7.11 → 42.7.12
             Drop each once the parent catches up. -->
        <netty.version>4.1.136.Final</netty.version>
        <postgresql.version>42.7.12</postgresql.version>
    </properties>

    <!-- Transitive versions the parent does NOT manage: both arrive through firebase-admin,
         which pins them itself, so a property cannot move them. Pinned here at the patched
         versions the dependency scan asks for; remove an entry once firebase-admin ships it. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-netty-shaded</artifactId>
                <version>1.75.0</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents.core5</groupId>
                <artifactId>httpcore5</artifactId>
                <version>5.4.3</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents.core5</groupId>
                <artifactId>httpcore5-h2</artifactId>
                <version>5.4.3</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-graphql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- PDF text extraction so the AI can read uploaded file resources (e.g. a CV) -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.3</version>
        </dependency>

        <!-- Verifies the Google ID token that the native Android app posts to
             /api/auth/google/mobile (GoogleIdTokenVerifier). Exclude commons-logging:
             it reintroduces a second JCL provider that clashes with Spring's spring-jcl. -->
        <dependency>
            <groupId>com.google.api-client</groupId>
            <artifactId>google-api-client</artifactId>
            <version>2.7.0</version>
            <exclusions>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Firebase Admin SDK: sends FCM push notifications to registered devices.
             Only used when a service-account credential is configured (FirebaseConfig);
             absent credentials degrade to a no-op, so local/dev/CI run without it. -->
        <dependency>
            <groupId>com.google.firebase</groupId>
            <artifactId>firebase-admin</artifactId>
            <version>9.4.1</version>
            <exclusions>
                <!-- Same reason as google-api-client above: keep a single JCL provider
                     (Spring's spring-jcl) and avoid the commons-logging clash. -->
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <!-- Sessions stored in PostgreSQL: Cloud Run scales to zero, and
             in-memory JSESSIONID sessions die with the instance — every cold
             start used to log everyone out and silently drop their saves. -->
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-jdbc</artifactId>
        </dependency>
        <!-- In-process token-bucket rate limiting (no external broker). Single
             instance is fine for this app's scale; buckets are per user/IP. -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j_jdk17-core</artifactId>
            <version>8.14.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.graphql</groupId>
            <artifactId>spring-graphql-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-junit5</artifactId>
            <version>2.29.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
