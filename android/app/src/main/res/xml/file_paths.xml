<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- The "shared" cache subfolder holds temporary copies of resource images shared to the
         clipboard via FileProvider (see ResourceActions.copyImageToClipboard). -->
    <cache-path name="shared" path="shared/" />
    <!-- Where the camera writes a photo taken from the chat composer. The cache dir, not the
         gallery: the shot is an attachment for one message, not something the user asked to keep,
         and it is deleted as soon as it has been read. -->
    <cache-path name="camera" path="camera/" />
</paths>
